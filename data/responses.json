{
  "surveys": [
    {
      "id": "asthma-daily",
      "title": "Asthma Daily Check-in",
      "condition": "asthma",
      "frequency": "daily",
      "questions": [
        {
          "id": "day_symptoms",
          "type": "radio",
          "prompt": "Have you had asthma symptoms 3 or more times today?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "symptoms",
          "type": "mcq",
          "prompt": "Which symptoms do you have today? (select all that apply)",
          "options": [
            "Tight chest",
            "Coughing",
            "Wheezing",
            "Shortness of breath",
            "Chest pain",
            "None"
          ]
        },
        {
          "id": "night_waking",
          "type": "radio",
          "prompt": "Did asthma wake you up last night?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "rescue_inhaler",
          "type": "radio",
          "prompt": "Have you used your rescue inhaler today?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "activity_limit",
          "type": "slider",
          "prompt": "How much did asthma limit your usual activities today?",
          "min": 0,
          "max": 10,
          "step": 1,
          "minLabel": "Not at all",
          "maxLabel": "Completely"
        },
        {
          "id": "note",
          "type": "text",
          "prompt": "Anything else you want your care team to know?",
          "optional": true
        }
      ]
    },
    {
      "id": "cold-daily",
      "title": "Common Cold Daily Check-in",
      "condition": "common cold",
      "frequency": "daily",
      "questions": [
        {
          "id": "overall_severity",
          "type": "slider",
          "prompt": "How bad do your cold symptoms feel today?",
          "min": 0,
          "max": 10,
          "step": 1,
          "minLabel": "No symptoms",
          "maxLabel": "Very severe"
        },
        {
          "id": "fever",
          "type": "radio",
          "prompt": "What was your highest temperature today?",
          "options": [
            "No fever",
            "Low (99-100.3 F)",
            "Moderate (100.4-102 F)",
            "High (over 102 F)"
          ]
        },
        {
          "id": "symptoms",
          "type": "mcq",
          "prompt": "Which symptoms do you have today? (select all that apply)",
          "options": [
            "Runny nose",
            "Stuffy nose",
            "Sore throat",
            "Cough",
            "Sneezing",
            "Headache",
            "Body aches",
            "Ear pain"
          ]
        },
        {
          "id": "sleep_quality",
          "type": "slider",
          "prompt": "How well did you sleep last night?",
          "min": 1,
          "max": 5,
          "step": 1,
          "minLabel": "Very poorly",
          "maxLabel": "Very well"
        },
        {
          "id": "note",
          "type": "text",
          "prompt": "Anything else you want your care team to know?",
          "optional": true
        }
      ]
    }
  ],
