{
  "surveys": [
    {
      "id": "asthma-daily",
      "title": "Asthma Daily Check-in",
      "condition": "asthma",
      "frequency": "daily",
      "questions": [
        {
          "id": "day_symptoms",
          "type": "radio",
          "prompt": "Have you had asthma symptoms 3 or more times today?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "symptoms",
          "type": "mcq",
          "prompt": "Which symptoms do you have today? (select all that apply)",
          "options": [
            "Tight chest",
            "Coughing",
            "Wheezing",
            "Shortness of breath",
            "Chest pain",
            "None"
          ]
        },
        {
          "id": "night_waking",
          "type": "radio",
          "prompt": "Did asthma wake you up last night?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "rescue_inhaler",
          "type": "radio",
          "prompt": "Have you used your rescue inhaler today?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "id": "breathlessness",
          "type": "slider",
          "prompt": "How breathless were you today?",
          "min": 0,
          "max": 10,
          "step": 1,
          "minLabel": "Not at all",
          "maxLabel": "Severe"
        },
        {
          "id": "activity_limit",
          "type": "slider",
          "prompt": "How much did asthma limit your usual activities today?",
          "min": 0,
          "max": 10,
          "step": 1,
          "minLabel": "Not at all",
          "maxLabel": "Completely"
        },
        {
          "id": "note",
          "type": "text",
          "prompt": "Anything else you want your care team to know?",
          "optional": true
        }
      ]
    }
  ],
